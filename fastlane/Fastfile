default_platform(:ios)

platform :ios do
  # アプリの記録（App 名 / Bundle ID / SKU / 主言語）の新規作成は App Store Connect API では許可されていない
  # （apps は GET と UPDATE のみ）。初回は App Store Connect の Web で作る。以降のメタデータ・ビルドは API キーで上げられる

  desc "メタデータ（fastlane/metadata）とスクリーンショットをアップロード。binary は上げない"
  lane :upload_metadata do |options|
    setup_api_key
    deliver(
      skip_binary_upload: true,
      skip_screenshots: options[:skip_screenshots] || false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  # App のプライバシー（データを収集しない）、審査用の連絡先（電話番号・メール）、年齢制限の質問票は
  # fastlane から送れない（Apple ID ログインが必要、または質問票の形式が新しくなり項目が足りないと拒否される）。
  # いずれも App Store Connect の Web で設定する

  # ビルドをバージョンに紐づけるのは deliver では審査提出時にしか行われない。
  # 提出前に紐づけるなら Spaceship で app_store_version.select_build(build_id:) を呼ぶ（SPEC-REVIEW J 参照）か Web で選ぶ

  desc "予備: この Mac でアーカイブして TestFlight に上げる（通常は Xcode Cloud の Default ワークフローで配信する。SPEC-REVIEW J6）"
  lane :beta do
    setup_api_key
    build_app(
      scheme: "Agnoria",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      output_directory: "./fastlane/build",
      clean: true
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: File.read("./metadata/ja/release_notes.txt")  # fastlane の作業ディレクトリは fastlane/
    )
  end

  desc "ビルド済みの ipa（fastlane/build/Agnoria.ipa）だけを TestFlight に上げる"
  lane :upload_ipa do
    setup_api_key
    upload_to_testflight(
      ipa: "./fastlane/build/Agnoria.ipa",  # アクションの引数のパスはリポジトリ基点、File.read は fastlane/ 基点
      skip_waiting_for_build_processing: true,
      changelog: File.read("./metadata/ja/release_notes.txt")
    )
  end
end

# API キーは runrun-ios と同じもの（同じチーム）。リポジトリには置かない
def setup_api_key
  path = ENV["AGNORIA_ASC_API_KEY_JSON"] || File.expand_path("~/git/runrun-ios/fastlane/api_key.json")
  UI.user_error!("App Store Connect API キーが見つかりません: #{path}") unless File.exist?(path)
  json = JSON.parse(File.read(path))
  app_store_connect_api_key(
    key_id: json["key_id"],
    issuer_id: json["issuer_id"],
    key_content: json["key"],
    in_house: false
  )
end
